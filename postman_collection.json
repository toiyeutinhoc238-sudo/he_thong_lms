{
  "info": {
    "name": "HCMUE VLE LMS API Collection",
    "description": "Bộ sưu tập API cho Hệ thống LMS / VLE ĐH Sư phạm TP.HCM",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"48.01.104.055\",\n  \"password\": \"password123\",\n  \"program\": \"student_regular\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Get Current Profile (Me)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Courses",
      "item": [
        {
          "name": "Get All Courses",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/courses",
              "host": ["{{baseUrl}}"],
              "path": ["courses"]
            }
          }
        },
        {
          "name": "Create Course",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"TLH102\",\n  \"name\": \"Tâm lý học Sư phạm\",\n  \"category\": \"student_regular\",\n  \"credits\": 3,\n  \"semester\": \"Học kỳ 1\",\n  \"academicYear\": \"2026 - 2027\",\n  \"description\": \"Mô tả học phần tâm lý học sư phạm...\",\n  \"instructor\": {\n    \"name\": \"TS. Trần Minh Khoa\",\n    \"title\": \"Khoa Tâm lý GD\",\n    \"avatar\": \"https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=150\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/courses",
              "host": ["{{baseUrl}}"],
              "path": ["courses"]
            }
          }
        },
        {
          "name": "Get Course By ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/courses/:id",
              "host": ["{{baseUrl}}"],
              "path": ["courses", ":id"],
              "variable": [{ "key": "id", "value": "course-1" }]
            }
          }
        }
      ]
    },
    {
      "name": "3. Activities & Submissions",
      "item": [
        {
          "name": "Mark Activity Completed",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/courses/:courseId/activities/:activityId/complete",
              "host": ["{{baseUrl}}"],
              "path": ["courses", ":courseId", "activities", ":activityId", "complete"],
              "variable": [
                { "key": "courseId", "value": "course-1" },
                { "key": "activityId", "value": "act-1" }
              ]
            }
          }
        },
        {
          "name": "Submit Assignment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fileName\": \"BaiTap_TLH102.pdf\",\n  \"textSubmission\": \"Em xin nộp bài tập chuyên đề 2 ạ.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/courses/:courseId/activities/:activityId/submit",
              "host": ["{{baseUrl}}"],
              "path": ["courses", ":courseId", "activities", ":activityId", "submit"],
              "variable": [
                { "key": "courseId", "value": "course-1" },
                { "key": "activityId", "value": "act-1" }
              ]
            }
          }
        },
        {
          "name": "Grade Assignment (Lecturer)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"grade\": 9.5,\n  \"feedback\": \"Bài làm rất tốt, lập luận chặt chẽ.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/courses/:courseId/activities/:activityId/grade",
              "host": ["{{baseUrl}}"],
              "path": ["courses", ":courseId", "activities", ":activityId", "grade"],
              "variable": [
                { "key": "courseId", "value": "course-1" },
                { "key": "activityId", "value": "act-1" }
              ]
            }
          }
        },
        {
          "name": "Submit Quiz Answers",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"answers\": { \"q1\": 1, \"q2\": 0, \"q3\": 2 },\n  \"score\": 9.0,\n  \"maxScore\": 10\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/courses/:courseId/activities/:activityId/quiz-submit",
              "host": ["{{baseUrl}}"],
              "path": ["courses", ":courseId", "activities", ":activityId", "quiz-submit"],
              "variable": [
                { "key": "courseId", "value": "course-1" },
                { "key": "activityId", "value": "act-1" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Grades & Certificates",
      "item": [
        {
          "name": "Get My Grades",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/grades",
              "host": ["{{baseUrl}}"],
              "path": ["grades"]
            }
          }
        },
        {
          "name": "Get My Certificates",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/certificates",
              "host": ["{{baseUrl}}"],
              "path": ["certificates"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Notifications & Forum",
      "item": [
        {
          "name": "Get Notifications",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/notifications",
              "host": ["{{baseUrl}}"],
              "path": ["notifications"]
            }
          }
        },
        {
          "name": "Get Course Forum Topics",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/courses/:courseId/forum",
              "host": ["{{baseUrl}}"],
              "path": ["courses", ":courseId", "forum"],
              "variable": [{ "key": "courseId", "value": "course-1" }]
            }
          }
        }
      ]
    }
  ]
}
